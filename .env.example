# Copy this file to .env for local dev. On Railway, set these as
# environment variables in your service (DATABASE_URL is injected
# automatically when you attach a Postgres plugin — don't set it yourself).

PORT=3000

# --- Postgres ---
# Railway injects this automatically when you add a Postgres database to
# your project. For local dev, point it at your own Postgres instance.
DATABASE_URL=

# --- Alibaba Cloud Model Studio (DashScope) ---
# Used for: chat, prompt generation, image generation (default), image edit
ALIBABA_API_KEY=
ALIBABA_WORKSPACE_ID=
ALIBABA_REGION=ap-southeast-1

# --- Cloudflare Workers AI ---
# Used for: image generation (optional provider)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# --- Pixazo Gateway ---
# Used for: image generation (optional provider)
PIXAZO_API_KEY=

# --- Transloadit ---
# Used for: image generation AND image editing (google/nano-banana by default)
# Get Auth Key + Secret from your Transloadit Workspace's Credentials page.
TRANSLOADIT_AUTH_KEY=
TRANSLOADIT_AUTH_SECRET=

# --- imgbb ---
# Every generated/edited image is re-uploaded ("transloaded") here so you get
# a stable, permanent URL instead of relying on the AI provider's temp link.
# Get a free key at https://api.imgbb.com/
IMGBB_API_KEY=
